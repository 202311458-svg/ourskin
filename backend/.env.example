# Copy this file to backend/.env for local development only.
# Never commit populated environment files or use production credentials locally.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE

# Generate a cryptographically random value of at least 32 bytes.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=os-coms
JWT_AUDIENCE=os-coms-api

# Google Identity Services / OpenID Connect (public OAuth client ID, not a secret).
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_ONBOARDING_TOKEN_EXPIRE_MINUTES=15

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000
CLINIC_TIMEZONE=Asia/Manila

# Email provider (required only when email workflows are enabled).
RESEND_API_KEY=REPLACE_WITH_PROVIDER_KEY
RESEND_FROM_EMAIL=no-reply@example.invalid

# Private object storage (required for clinical image workflows).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRIVATE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=ourskin-images

# AI provider. Keep the real key only in the runtime environment/secrets manager.
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_PROJECT_KEY
AI_MODEL_ID=gpt-5.6-sol
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Maintenance threshold for database-known AI image assets that no longer have
# an analysis run. The dermatology upload flow also compensates immediately if
# its database transaction fails after storage upload.
AI_ORPHAN_ASSET_RETENTION_DAYS=7
